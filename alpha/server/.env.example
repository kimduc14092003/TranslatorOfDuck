# Chép thành .env rồi điền key. KHÔNG commit file .env.
# Dịch: điền một trong hai. Có OPENAI_API_KEY thì dùng OpenAI.
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Model suy luận: đặt mức thấp nhất model nhận (none, hoặc low), dịch phụ đề không cần nghĩ sâu.
# OPENAI_REASONING_EFFORT=none
# Dịch vụ cùng kiểu API với OpenAI (chạy trên máy hoặc nơi khác):
# OPENAI_BASE=http://127.0.0.1:PORT/v1
# DASHSCOPE_BASE=https://dashscope-intl.aliyuncs.com
# Nhận dạng giọng nói: Fun-ASR hết hạn mức thì tự chuyển sang model dự phòng. Để trống (ASR_FALLBACK_MODEL=) thì tắt.
# FUNASR_MODEL=fun-asr-flash-2026-06-15
# ASR_FALLBACK_MODEL=qwen-audio-3.1-asr-flash
# GEMINI_MODEL=gemini-3.5-flash-lite
# PORT=8787
# So sánh nhận dạng giọng nói (alpha/dev/real/asr-bench.mjs, server không dùng): điền key dịch vụ muốn thử, để trống thì bỏ qua.
# DashScope và Gemini dùng DASHSCOPE_API_KEY, GEMINI_API_KEY ở trên. Azure: key và vùng của resource Speech (ví dụ southeastasia).
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Model DashScope đem so (cách nhau dấu phẩy):
# ASR_BENCH_DASHSCOPE_MODELS=fun-asr,qwen3-asr-flash,qwen-audio-3.1-asr-flash
# ELEVENLABS_BASE=https://api.elevenlabs.io
# AZURE_SPEECH_BASE=https://<tên resource>.cognitiveservices.azure.com
