# Chép file này thành .env rồi điền key. KHÔNG commit file .env.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alibaba Model Studio quốc tế (Singapore): key của workspace
DASHSCOPE_API_KEY=
# Nếu bạn dùng domain workspace mới: https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com
# DASHSCOPE_BASE=https://dashscope-intl.aliyuncs.com
# Groq (không bắt buộc, dùng làm mốc so sánh Whisper)
GROQ_API_KEY=
# Model Gemini (mặc định gemini-3.5-flash-lite, có gói miễn phí)
# GEMINI_MODEL=gemini-3.5-flash-lite
